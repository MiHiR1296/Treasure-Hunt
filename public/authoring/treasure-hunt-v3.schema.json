{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/authoring/treasure-hunt-v3.schema.json",
  "title": "Treasure Hunt V3 external authoring document",
  "description": "Strict, secret-safe interchange format for AI-assisted V3 hunt drafts. Passing this schema is necessary but publication also requires server-side graph, reference, route-fairness, media, and secret-materialization validation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "title", "settings", "checkpoints"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "id": { "$ref": "#/definitions/id" },
    "version": { "type": "integer", "minimum": 1 },
    "title": { "$ref": "#/definitions/title" },
    "description": { "$ref": "#/definitions/longText" },
    "settings": { "$ref": "#/definitions/settings" },
    "theme": { "$ref": "#/definitions/theme" },
    "checkpoints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/definitions/checkpoint" }
    },
    "dudQrs": {
      "description": "Logical dud QR slots. Import replaces each generation directive with a private production token.",
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/definitions/dudQr" }
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"
    },
    "variableKey": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "shortText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "longText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "mediaUrl": {
      "type": "string",
      "maxLength": 2048,
      "anyOf": [
        { "pattern": "^https://[^\\s\\\\]+$" },
        { "pattern": "^/(?!/)[^\\s\\\\]*$" }
      ]
    },
    "isoTimestamp": {
      "type": "string",
      "format": "date-time"
    },
    "variableValue": {
      "oneOf": [
        { "type": "string", "maxLength": 1000 },
        { "type": "number", "minimum": -1000000000, "maximum": 1000000000 },
        { "type": "boolean" }
      ]
    },
    "qrGenerationDirective": {
      "description": "A logical name, never a live QR secret. The importer must replace this value before preview or publication.",
      "type": "string",
      "pattern": "^@server:generate:[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registrationMode",
        "integrityPolicy",
        "runPolicy",
        "leaderboardPolicy",
        "publicBoard",
        "socialShare",
        "recognition",
        "routePlan",
        "challengePools",
        "variableGenerators",
        "fairnessPolicy"
      ],
      "properties": {
        "mode": { "const": "sequential" },
        "map": { "enum": ["none", "all", "visited"] },
        "rules": { "$ref": "#/definitions/longText" },
        "minTeamSize": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "maxTeamSize": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "sessionDurationSeconds": { "type": "integer", "minimum": 1, "maximum": 31536000 },
        "registrationOpen": { "type": "boolean" },
        "startsAt": { "$ref": "#/definitions/isoTimestamp" },
        "endsAt": { "$ref": "#/definitions/isoTimestamp" },
        "completionMessage": { "$ref": "#/definitions/longText" },
        "photoRetention": { "enum": ["after_verification", "after_event", "retain"] },
        "registrationMode": { "enum": ["self-serve", "organizer-assigned", "rostered"] },
        "integrityPolicy": { "$ref": "#/definitions/integrityPolicy" },
        "runPolicy": { "$ref": "#/definitions/runPolicy" },
        "leaderboardPolicy": { "$ref": "#/definitions/leaderboardPolicy" },
        "publicBoard": { "$ref": "#/definitions/publicBoard" },
        "socialShare": { "$ref": "#/definitions/socialShare" },
        "recognition": { "$ref": "#/definitions/recognition" },
        "routePlan": { "$ref": "#/definitions/routePlan" },
        "challengePools": {
          "type": "object",
          "maxProperties": 100,
          "propertyNames": { "$ref": "#/definitions/id" },
          "additionalProperties": { "$ref": "#/definitions/challengePool" }
        },
        "parallelMechanics": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/definitions/parallelMechanic" }
        },
        "variableGenerators": {
          "type": "object",
          "maxProperties": 100,
          "propertyNames": { "$ref": "#/definitions/variableKey" },
          "additionalProperties": { "$ref": "#/definitions/variableGenerator" }
        },
        "fairnessPolicy": { "$ref": "#/definitions/fairnessPolicy" }
      }
    },
    "integrityPolicy": {
      "description": "Organizer-selected balance between casual access and competition integrity. Attempt budgets remain team-wide in every mode.",
      "type": "object",
      "additionalProperties": false,
      "required": ["locationVerification", "selfServeApproval", "rosterParticipation"],
      "properties": {
        "locationVerification": { "enum": ["gps_only", "gps_photo", "gps_organizer", "strict"] },
        "selfServeApproval": { "enum": ["automatic", "organizer"] },
        "rosterParticipation": { "enum": ["flexible", "freeze_at_run_start", "flexible_fixed_scoring"] }
      }
    },
    "runPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["disabled", "capped", "unlimited", "practice-only"] },
        "maxOfficialRuns": { "type": "integer", "minimum": 1, "maximum": 1000 }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "capped" } } },
          "then": { "required": ["maxOfficialRuns"] },
          "else": { "not": { "required": ["maxOfficialRuns"] } }
        }
      ]
    },
    "leaderboardPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bestRunRule", "mainBoardEnabled", "replayBoardEnabled", "replayBoardPublic", "timeVisibility", "showProgress"],
      "properties": {
        "bestRunRule": { "const": "score_then_time_then_completion" },
        "mainBoardEnabled": { "type": "boolean" },
        "replayBoardEnabled": { "type": "boolean" },
        "replayBoardPublic": { "type": "boolean" },
        "timeVisibility": { "enum": ["never", "after_second_eligible_run", "always"] },
        "showProgress": { "type": "boolean" }
      }
    },
    "publicBoard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "status", "teamIdentity", "columns"],
      "properties": {
        "enabled": { "type": "boolean" },
        "slug": { "$ref": "#/definitions/id" },
        "title": { "$ref": "#/definitions/title" },
        "coverUrl": { "$ref": "#/definitions/mediaUrl" },
        "status": { "enum": ["live", "frozen", "final"] },
        "teamIdentity": { "enum": ["code_only", "code_and_name"] },
        "columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 9,
          "uniqueItems": true,
          "items": { "enum": ["rank", "team_code", "team_name", "points", "progress", "completion_status", "runs", "time"] }
        }
      }
    },
    "socialShare": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "allowPersonalTitle"],
      "properties": {
        "enabled": { "type": "boolean" },
        "allowPersonalTitle": { "type": "boolean" },
        "organizerHandle": { "type": "string", "pattern": "^@?[A-Za-z0-9._]{1,30}$" },
        "campaignHashtag": { "type": "string", "pattern": "^#[A-Za-z0-9_]{1,100}$" }
      }
    },
    "recognition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "peerVotingEnabled", "votingWindowMinutes", "dataWeight", "peerWeight"],
      "properties": {
        "enabled": { "type": "boolean" },
        "peerVotingEnabled": { "type": "boolean" },
        "votingWindowMinutes": { "type": "integer", "minimum": 1, "maximum": 10080 },
        "dataWeight": { "type": "number", "minimum": 0, "maximum": 1 },
        "peerWeight": { "type": "number", "minimum": 0, "maximum": 1 },
        "titleLibrary": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 6,
          "propertyNames": { "enum": ["trailblazer", "puzzle_ace", "codebreaker", "eagle_eye", "clutch_player", "team_spark"] },
          "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 100 }
        }
      }
    },
    "routePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startCheckpointId", "finaleCheckpointId", "requiredCheckpointIds", "choose", "checkpointEstimates", "travelEstimates"],
      "properties": {
        "startCheckpointId": { "$ref": "#/definitions/id" },
        "finaleCheckpointId": { "$ref": "#/definitions/id" },
        "requiredCheckpointIds": {
          "type": "array",
          "minItems": 0,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/id" }
        },
        "choose": {
          "type": "object",
          "additionalProperties": false,
          "required": ["count", "fromCheckpointIds"],
          "properties": {
            "count": { "type": "integer", "minimum": 0, "maximum": 100 },
            "fromCheckpointIds": {
              "type": "array",
              "maxItems": 100,
              "uniqueItems": true,
              "items": { "$ref": "#/definitions/id" }
            }
          }
        },
        "shuffleSelectedCheckpoints": { "type": "boolean" },
        "avoidTransitions": {
          "type": "array",
          "maxItems": 500,
          "items": { "$ref": "#/definitions/routeTransition" }
        },
        "checkpointEstimates": {
          "type": "object",
          "maxProperties": 100,
          "propertyNames": { "$ref": "#/definitions/id" },
          "additionalProperties": { "$ref": "#/definitions/checkpointEstimate" }
        },
        "travelEstimates": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "#/definitions/travelEstimate" }
        }
      }
    },
    "routeTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "$ref": "#/definitions/id" },
        "to": { "$ref": "#/definitions/id" }
      }
    },
    "checkpointEstimate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "durationMinutes": { "type": "number", "exclusiveMinimum": 0, "maximum": 525600 },
        "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 }
      },
      "minProperties": 1
    },
    "travelEstimate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "$ref": "#/definitions/id" },
        "to": { "$ref": "#/definitions/id" },
        "durationMinutes": { "type": "number", "exclusiveMinimum": 0, "maximum": 525600 },
        "distanceMeters": { "type": "number", "minimum": 0, "maximum": 100000000 },
        "bidirectional": { "type": "boolean" }
      },
      "anyOf": [
        { "required": ["durationMinutes"] },
        { "required": ["distanceMeters"] }
      ]
    },
    "challengePool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "variants"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "variants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "$ref": "#/definitions/challengeVariant" }
        }
      }
    },
    "challengeVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "checkpointId"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "checkpointId": { "$ref": "#/definitions/id" },
        "estimatedDurationMinutes": { "type": "number", "exclusiveMinimum": 0, "maximum": 525600 },
        "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
        "scoreCeiling": { "type": "integer", "minimum": 0, "maximum": 100000000 },
        "weight": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000000 }
      }
    },
    "parallelMechanic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "checkpointId", "nodeId", "timeWindowSeconds", "lanes"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "checkpointId": { "$ref": "#/definitions/id" },
        "nodeId": { "$ref": "#/definitions/id" },
        "timeWindowSeconds": { "type": "integer", "minimum": 5, "maximum": 86400 },
        "lanes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 20,
          "items": { "$ref": "#/definitions/parallelLane" }
        }
      }
    },
    "parallelLane": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "label", "type", "token"],
          "properties": {
            "id": { "$ref": "#/definitions/id" },
            "label": { "$ref": "#/definitions/title" },
            "type": { "const": "qr" },
            "token": { "$ref": "#/definitions/qrGenerationDirective" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "label", "type", "code"],
          "properties": {
            "id": { "$ref": "#/definitions/id" },
            "label": { "$ref": "#/definitions/title" },
            "type": { "const": "code" },
            "code": { "type": "string", "minLength": 4, "maxLength": 2048 },
            "caseSensitive": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "label", "type", "location"],
          "properties": {
            "id": { "$ref": "#/definitions/id" },
            "label": { "$ref": "#/definitions/title" },
            "type": { "const": "gps" },
            "location": { "$ref": "#/definitions/gpsRegion" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "label", "type"],
          "properties": {
            "id": { "$ref": "#/definitions/id" },
            "label": { "$ref": "#/definitions/title" },
            "type": { "const": "photo" },
            "location": { "$ref": "#/definitions/gpsRegion" }
          }
        }
      ]
    },
    "variableGenerator": {
      "oneOf": [
        { "$ref": "#/definitions/literalGenerator" },
        { "$ref": "#/definitions/choiceGenerator" },
        { "$ref": "#/definitions/codeGenerator" },
        { "$ref": "#/definitions/integerGenerator" }
      ]
    },
    "literalGenerator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "literal" },
        "value": { "$ref": "#/definitions/variableValue" }
      }
    },
    "choiceGenerator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "values"],
      "properties": {
        "type": { "const": "choice" },
        "values": {
          "type": "array",
          "minItems": 2,
          "maxItems": 10000,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/variableValue" }
        }
      }
    },
    "codeGenerator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "alphabet", "length"],
      "properties": {
        "type": { "const": "code" },
        "alphabet": { "type": "string", "minLength": 2, "maxLength": 128 },
        "length": { "type": "integer", "minimum": 4, "maximum": 64 }
      }
    },
    "integerGenerator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "minimum", "maximum"],
      "properties": {
        "type": { "const": "integer" },
        "minimum": { "type": "integer", "minimum": -1000000000, "maximum": 1000000000 },
        "maximum": { "type": "integer", "minimum": -1000000000, "maximum": 1000000000 },
        "step": { "type": "integer", "minimum": 1, "maximum": 1000000000 }
      }
    },
    "fairnessPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimumDistinctPlans",
        "durationToleranceMinutes",
        "maxResolvedRoutes",
        "requireTravelEstimates",
        "walkingSpeedMetersPerMinute",
        "minutesPerDifficultyPoint"
      ],
      "properties": {
        "minimumDistinctPlans": { "type": "integer", "minimum": 2, "maximum": 100000 },
        "durationToleranceMinutes": { "const": 0 },
        "maxResolvedRoutes": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "requireTravelEstimates": { "const": true },
        "walkingSpeedMetersPerMinute": { "type": "number", "exclusiveMinimum": 0, "maximum": 1200 },
        "minutesPerDifficultyPoint": { "type": "number", "exclusiveMinimum": 0, "maximum": 10000 }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "primaryColor": { "type": "string", "pattern": "^#[A-Fa-f0-9]{6}$" },
        "logoUrl": { "$ref": "#/definitions/mediaUrl" },
        "coverUrl": { "$ref": "#/definitions/mediaUrl" },
        "backgroundUrl": { "$ref": "#/definitions/mediaUrl" },
        "font": { "enum": ["system", "serif"] },
        "feedback": { "type": "boolean" },
        "buttonShape": { "enum": ["rounded", "pill", "square"] },
        "checkpointIconStyle": { "enum": ["numbers", "symbols", "none"] },
        "successAnimation": { "enum": ["none", "pulse", "celebrate"] }
      }
    },
    "mapLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latitude", "longitude", "radiusMeters"],
      "properties": {
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "radiusMeters": { "type": "number", "minimum": 1, "maximum": 100000 }
      }
    },
    "gpsRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latitude", "longitude", "radiusMeters", "maxAccuracyMeters"],
      "properties": {
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "radiusMeters": { "type": "number", "minimum": 1, "maximum": 100000 },
        "maxAccuracyMeters": { "type": "number", "minimum": 1, "maximum": 100000 }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "basePoints", "flow", "hints"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "title": { "$ref": "#/definitions/title" },
        "basePoints": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "required": { "const": true },
        "prerequisites": {
          "type": "array",
          "maxItems": 0,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/id" }
        },
        "group": { "$ref": "#/definitions/title" },
        "location": { "$ref": "#/definitions/mapLocation" },
        "wrongAttemptPenalty": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "skipPenalty": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "timeBonus": {
          "type": "object",
          "additionalProperties": false,
          "required": ["withinSeconds", "points"],
          "properties": {
            "withinSeconds": { "type": "integer", "minimum": 1, "maximum": 31536000 },
            "points": { "type": "integer", "minimum": 0, "maximum": 1000000 },
            "rankingImpact": { "$ref": "#/definitions/rankingImpact" }
          }
        },
        "flow": { "$ref": "#/definitions/flow" },
        "hints": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/definitions/hint" }
        }
      }
    },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startNodeId", "nodes"],
      "properties": {
        "startNodeId": { "$ref": "#/definitions/id" },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": { "$ref": "#/definitions/flowNode" }
        }
      }
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "label", "enabled"],
      "properties": {
        "nodeId": { "$ref": "#/definitions/id" },
        "label": { "$ref": "#/definitions/title" },
        "enabled": { "type": "boolean" }
      }
    },
    "flowNode": {
      "oneOf": [
        { "$ref": "#/definitions/showTextNode" },
        { "$ref": "#/definitions/showMediaNode" },
        { "$ref": "#/definitions/verifyQrNode" },
        { "$ref": "#/definitions/verifyCodeNode" },
        { "$ref": "#/definitions/verifyAnswerNode" },
        { "$ref": "#/definitions/verifyGpsNode" },
        { "$ref": "#/definitions/choosePathNode" },
        { "$ref": "#/definitions/puzzleNode" },
        { "$ref": "#/definitions/cameraGuideNode" },
        { "$ref": "#/definitions/verifyOrganizerNode" },
        { "$ref": "#/definitions/verifyImageNode" },
        { "$ref": "#/definitions/setVariableNode" },
        { "$ref": "#/definitions/branchNode" },
        { "$ref": "#/definitions/randomBranchNode" },
        { "$ref": "#/definitions/addPointsNode" },
        { "$ref": "#/definitions/completeNode" }
      ]
    },
    "showTextNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "text", "next"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "type": { "const": "show_text" },
        "text": { "$ref": "#/definitions/longText" },
        "next": { "$ref": "#/definitions/id" },
        "fallback": { "$ref": "#/definitions/fallback" }
      }
    },
    "showMediaNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "content", "next"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "type": { "const": "show_media" },
        "content": { "$ref": "#/definitions/displayContent" },
        "next": { "$ref": "#/definitions/id" },
        "fallback": { "$ref": "#/definitions/fallback" }
      }
    },
    "verifyQrNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "prompt", "token", "next"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "type": { "const": "verify_qr" },
        "prompt": { "$ref": "#/definitions/longText" },
        "clue": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "token": { "$ref": "#/definitions/qrGenerationDirective" },
        "backupCode": { "$ref": "#/definitions/qrGenerationDirective" },
        "next": { "$ref": "#/definitions/id" },
        "fallback": { "$ref": "#/definitions/fallback" }
      }
    },
    "verifyCodeNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "prompt", "code", "next"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "type": { "const": "verify_code" },
        "prompt": { "$ref": "#/definitions/longText" },
        "clue": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "code": { "type": "string", "minLength": 4, "maxLength": 2048 },
        "caseSensitive": { "type": "boolean" },
        "recapAnswer": { "type": "string", "minLength": 1, "maxLength": 500 },
        "next": { "$ref": "#/definitions/id" },
        "fallback": { "$ref": "#/definitions/fallback" }
      }
    },
    "verifyAnswerNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "prompt", "answers", "next"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "type": { "const": "verify_answer" },
        "prompt": { "$ref": "#/definitions/longText" },
        "clue": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "answers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
        },
        "caseSensitive": { "type": "boolean" },
        "recapAnswer": { "type": "string", "minLength": 1, "maxLength": 500 },
        "recordAnswerAttempts": { "type": "boolean" },
        "next": { "$ref": "#/definitions/id" },
        "fallback": { "$ref": "#/definitions/fallback" }
      }
    },
    "verifyGpsNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "prompt", "latitude", "longitude", "radiusMeters", "maxAccuracyMeters", "next"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "type": { "const": "verify_gps" },
        "prompt": { "$ref": "#/definitions/longText" },
        "clue": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "radiusMeters": { "type": "number", "minimum": 1, "maximum": 100000 },
        "maxAccuracyMeters": { "type": "number", "minimum": 1, "maximum": 100000 },
        "next": { "$ref": "#/definitions/id" },
        "fallback": { "$ref": "#/definitions/fallback" }
      }
    },
    "choosePathNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "prompt", "choices"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "type": { "const": "choose_path" },
        "prompt": { "$ref": "#/definitions/longText" },
        "clue": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "choices": {
          "type": "array",
          "minItems": 2,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "next"],
            "properties": {
              "id": { "$ref": "#/definitions/id" },
              "label": { "$ref": "#/definitions/title" },
              "next": { "$ref": "#/definitions/id" }
            }
          }
        },
        "fallback": { "$ref": "#/definitions/fallback" }
      }
    },
    "puzzleNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "prompt", "puzzle", "next"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "type": { "const": "puzzle" },
        "prompt": { "$ref": "#/definitions/longText" },
        "clue": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "puzzle": { "$ref": "#/definitions/puzzle" },
        "next": { "$ref": "#/definitions/id" },
        "fallback": { "$ref": "#/definitions/fallback" }
      }
    },
    "cameraGuideNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "prompt", "next"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "type": { "const": "camera_guide" },
        "prompt": { "$ref": "#/definitions/longText" },
        "clue": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "referenceImageUrl": { "$ref": "#/definitions/mediaUrl" },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "next": { "$ref": "#/definitions/id" },
        "fallback": { "$ref": "#/definitions/fallback" }
      },
      "dependencies": {
        "latitude": ["longitude"],
        "longitude": ["latitude"]
      }
    },
    "verifyOrganizerNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "prompt", "next"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "type": { "const": "verify_organizer" },
        "prompt": { "$ref": "#/definitions/longText" },
        "clue": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "next": { "$ref": "#/definitions/id" },
        "fallback": { "$ref": "#/definitions/fallback" }
      }
    },
    "verifyImageNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "prompt", "referenceImages", "next"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "type": { "const": "verify_image" },
        "prompt": { "$ref": "#/definitions/longText" },
        "clue": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "referenceImages": {
          "type": "array",
          "maxItems": 30,
          "items": { "$ref": "#/definitions/mediaUrl" }
        },
        "location": { "$ref": "#/definitions/gpsRegion" },
        "next": { "$ref": "#/definitions/id" },
        "fallback": { "$ref": "#/definitions/fallback" }
      }
    },
    "setVariableNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "key", "value", "next"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "type": { "const": "set_variable" },
        "key": { "$ref": "#/definitions/id" },
        "value": { "$ref": "#/definitions/variableValue" },
        "next": { "$ref": "#/definitions/id" }
      }
    },
    "branchNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "condition", "ifTrue", "ifFalse"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "type": { "const": "branch" },
        "condition": { "$ref": "#/definitions/condition" },
        "ifTrue": { "$ref": "#/definitions/id" },
        "ifFalse": { "$ref": "#/definitions/id" }
      }
    },
    "randomBranchNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "choices"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "type": { "const": "random_branch" },
        "choices": {
          "type": "array",
          "minItems": 2,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["next", "weight"],
            "properties": {
              "next": { "$ref": "#/definitions/id" },
              "weight": { "type": "integer", "minimum": 1, "maximum": 10000 }
            }
          }
        }
      }
    },
    "addPointsNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "amount", "label", "next"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "type": { "const": "add_points" },
        "amount": { "type": "integer", "minimum": -1000000, "maximum": 1000000 },
        "label": { "$ref": "#/definitions/title" },
        "rankingImpact": { "$ref": "#/definitions/rankingImpact" },
        "next": { "$ref": "#/definitions/id" }
      }
    },
    "completeNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "type": { "const": "complete" }
      }
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "key", "equals"],
          "properties": {
            "type": { "const": "variable" },
            "key": { "$ref": "#/definitions/id" },
            "equals": { "$ref": "#/definitions/variableValue" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "checkpointId"],
          "properties": {
            "type": { "const": "checkpoint_completed" },
            "checkpointId": { "$ref": "#/definitions/id" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "hintId"],
          "properties": {
            "type": { "const": "hint_used" },
            "hintId": { "$ref": "#/definitions/id" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "after", "before"],
          "properties": {
            "type": { "const": "time" },
            "after": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
            "before": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" }
          }
        }
      ]
    },
    "displayContent": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "text"],
          "properties": {
            "type": { "const": "text" },
            "text": { "$ref": "#/definitions/longText" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "url", "alt"],
          "properties": {
            "type": { "const": "image" },
            "url": { "$ref": "#/definitions/mediaUrl" },
            "alt": { "type": "string", "minLength": 1, "maxLength": 1000 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "latitude", "longitude", "radiusMeters"],
          "properties": {
            "type": { "const": "map" },
            "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
            "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
            "radiusMeters": { "type": "number", "minimum": 1, "maximum": 100000 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "url", "title"],
          "properties": {
            "type": { "enum": ["audio", "video"] },
            "url": { "$ref": "#/definitions/mediaUrl" },
            "title": { "$ref": "#/definitions/title" },
            "transcript": { "$ref": "#/definitions/longText" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "description"],
          "properties": {
            "type": { "const": "camera" },
            "referenceImageUrl": { "$ref": "#/definitions/mediaUrl" },
            "description": { "$ref": "#/definitions/longText" },
            "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
            "longitude": { "type": "number", "minimum": -180, "maximum": 180 }
          },
          "dependencies": {
            "latitude": ["longitude"],
            "longitude": ["latitude"]
          }
        }
      ]
    },
    "hintContent": {
      "oneOf": [
        { "$ref": "#/definitions/displayContent" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "puzzle", "reveal"],
          "properties": {
            "type": { "const": "puzzle" },
            "puzzle": { "$ref": "#/definitions/puzzle" },
            "reveal": { "$ref": "#/definitions/displayContent" }
          }
        }
      ]
    },
    "hint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "cost", "content"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "title": { "$ref": "#/definitions/title" },
        "cost": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "content": { "$ref": "#/definitions/hintContent" },
        "availability": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "afterHintIds": {
              "type": "array",
              "maxItems": 100,
              "uniqueItems": true,
              "items": { "$ref": "#/definitions/id" }
            },
            "afterSeconds": { "type": "integer", "minimum": 0, "maximum": 31536000 },
            "afterNodeId": { "$ref": "#/definitions/id" }
          }
        },
        "relevance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nodeId"],
          "properties": {
            "nodeId": { "$ref": "#/definitions/id" },
            "puzzleItemId": { "type": "string", "minLength": 1, "maxLength": 2048 },
            "unlockAfterAttempts": { "type": "integer", "minimum": 0, "maximum": 1000 },
            "unlockAfterSeconds": { "type": "integer", "minimum": 0, "maximum": 31536000 },
            "expireWhenSolved": { "type": "boolean" }
          }
        },
        "enabled": { "type": "boolean" },
        "showWhenLocked": { "type": "boolean" }
      }
    },
    "puzzle": {
      "oneOf": [
        { "$ref": "#/definitions/jigsawPuzzle" },
        { "$ref": "#/definitions/sudokuPuzzle" },
        { "$ref": "#/definitions/wordSearchPuzzle" },
        { "$ref": "#/definitions/crosswordPuzzle" },
        { "$ref": "#/definitions/rotationPuzzle" },
        { "$ref": "#/definitions/textPuzzle" },
        { "$ref": "#/definitions/multipleChoicePuzzle" },
        { "$ref": "#/definitions/quizPuzzle" },
        { "$ref": "#/definitions/matchingPuzzle" },
        { "$ref": "#/definitions/sequencePuzzle" }
      ]
    },
    "puzzleItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "label": { "$ref": "#/definitions/shortText" }
      }
    },
    "imagePiece": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "imageUrl"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "imageUrl": { "$ref": "#/definitions/mediaUrl" },
        "alt": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "jigsawPuzzle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "rows", "columns", "pieces", "solution"],
      "properties": {
        "type": { "const": "jigsaw" },
        "rows": { "type": "integer", "minimum": 2, "maximum": 8 },
        "columns": { "type": "integer", "minimum": 2, "maximum": 8 },
        "pieces": {
          "type": "array",
          "minItems": 6,
          "maxItems": 64,
          "items": { "$ref": "#/definitions/imagePiece" }
        },
        "solution": {
          "type": "array",
          "minItems": 6,
          "maxItems": 64,
          "items": { "$ref": "#/definitions/id" }
        }
      }
    },
    "sudokuPuzzle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "size", "givens"],
      "properties": {
        "type": { "const": "sudoku" },
        "size": { "enum": [4, 6, 9] },
        "givens": {
          "type": "array",
          "minItems": 4,
          "maxItems": 9,
          "items": {
            "type": "array",
            "minItems": 4,
            "maxItems": 9,
            "items": { "type": "integer", "minimum": 0, "maximum": 9 }
          }
        }
      }
    },
    "wordSearchPuzzle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "grid", "words"],
      "properties": {
        "type": { "const": "word_search" },
        "grid": {
          "type": "array",
          "minItems": 2,
          "maxItems": 25,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 25,
            "items": { "type": "string", "pattern": "^[A-Za-z]$" }
          }
        },
        "words": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z]{2,}$" }
        },
        "minimumWords": { "type": "integer", "minimum": 1, "maximum": 50 },
        "bonusPerExtraWord": { "type": "integer", "minimum": 0, "maximum": 100 },
        "bonusRankingImpact": { "$ref": "#/definitions/rankingImpact" }
      }
    },
    "crosswordPuzzle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "rows", "columns", "entries"],
      "properties": {
        "type": { "const": "crossword" },
        "rows": { "type": "integer", "minimum": 2, "maximum": 30 },
        "columns": { "type": "integer", "minimum": 2, "maximum": 30 },
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "clue", "answer", "row", "column", "direction"],
            "properties": {
              "id": { "$ref": "#/definitions/id" },
              "clue": { "$ref": "#/definitions/longText" },
              "answer": { "type": "string", "pattern": "^[A-Za-z]+$" },
              "row": { "type": "integer", "minimum": 0, "maximum": 29 },
              "column": { "type": "integer", "minimum": 0, "maximum": 29 },
              "direction": { "enum": ["across", "down"] }
            }
          }
        }
      }
    },
    "rotationTile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "imageUrl", "correctRotation"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "imageUrl": { "$ref": "#/definitions/mediaUrl" },
        "alt": { "type": "string", "minLength": 1, "maxLength": 500 },
        "correctRotation": { "enum": [0, 90, 180, 270] }
      }
    },
    "rotationPuzzle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "columns", "tiles"],
      "properties": {
        "type": { "const": "rotation" },
        "columns": { "type": "integer", "minimum": 1, "maximum": 8 },
        "tiles": {
          "type": "array",
          "minItems": 6,
          "maxItems": 64,
          "items": { "$ref": "#/definitions/rotationTile" }
        }
      }
    },
    "textPuzzle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "prompt", "answers"],
      "properties": {
        "type": { "const": "text" },
        "prompt": { "$ref": "#/definitions/longText" },
        "answers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
        },
        "caseSensitive": { "type": "boolean" }
      }
    },
    "multipleChoicePuzzle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "prompt", "options", "correctOptionId"],
      "properties": {
        "type": { "const": "multiple_choice" },
        "prompt": { "$ref": "#/definitions/longText" },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 30,
          "items": { "$ref": "#/definitions/puzzleItem" }
        },
        "correctOptionId": { "$ref": "#/definitions/id" }
      }
    },
    "quizPuzzle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "questions", "minimumCorrect"],
      "properties": {
        "type": { "const": "quiz" },
        "questions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "prompt", "options", "correctOptionId"],
            "properties": {
              "id": { "$ref": "#/definitions/id" },
              "prompt": { "$ref": "#/definitions/longText" },
              "options": {
                "type": "array",
                "minItems": 2,
                "maxItems": 30,
                "items": { "$ref": "#/definitions/puzzleItem" }
              },
              "correctOptionId": { "$ref": "#/definitions/id" },
              "skipPenalty": { "type": "integer", "minimum": 0, "maximum": 1000000 }
            }
          }
        },
        "minimumCorrect": { "type": "integer", "minimum": 1, "maximum": 50 },
        "bonusPerAdditionalCorrect": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "bonusRankingImpact": { "$ref": "#/definitions/rankingImpact" }
      }
    },
    "matchingPair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["leftId", "rightId"],
      "properties": {
        "leftId": { "$ref": "#/definitions/id" },
        "rightId": { "$ref": "#/definitions/id" }
      }
    },
    "matchingPuzzle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "left", "right", "solution"],
      "properties": {
        "type": { "const": "matching" },
        "left": {
          "type": "array",
          "minItems": 5,
          "maxItems": 30,
          "items": { "$ref": "#/definitions/puzzleItem" }
        },
        "right": {
          "type": "array",
          "minItems": 5,
          "maxItems": 30,
          "items": { "$ref": "#/definitions/puzzleItem" }
        },
        "solution": {
          "type": "array",
          "minItems": 5,
          "maxItems": 30,
          "items": { "$ref": "#/definitions/matchingPair" }
        }
      }
    },
    "sequencePuzzle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "items", "solution"],
      "properties": {
        "type": { "const": "sequence" },
        "items": {
          "type": "array",
          "minItems": 6,
          "maxItems": 30,
          "items": { "$ref": "#/definitions/puzzleItem" }
        },
        "solution": {
          "type": "array",
          "minItems": 6,
          "maxItems": 30,
          "items": { "$ref": "#/definitions/id" }
        }
      }
    },
    "dudQr": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token", "message"],
      "properties": {
        "token": { "$ref": "#/definitions/qrGenerationDirective" },
        "message": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "points": { "type": "integer", "minimum": -1000000, "maximum": 1000000 },
        "rankingImpact": { "$ref": "#/definitions/rankingImpact" }
      }
    },
    "rankingImpact": {
      "description": "competitive (default) counts toward official ranking; excluded is recorded as a private extra bonus and omitted from leaderboard score and route-ceiling proof.",
      "enum": ["competitive", "excluded"]
    }
  }
}
