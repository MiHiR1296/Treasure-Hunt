# Server-only credentials. Do not prefix these with NEXT_PUBLIC_.
DATABASE_URL=postgresql://postgres:change-this-password@localhost:5432/treasure_hunt
ORGANIZER_PASSWORD=replace-with-a-long-unique-password
APP_ORIGIN=http://localhost:3000
# V1 routes and browser-based Supabase writes are disabled by default.
ENABLE_LEGACY_V1=false
# Docker Compose database credentials (URL-safe characters):
POSTGRES_PASSWORD=change-this-password
# Optional local port or production HTTPS configuration:
# WEB_PORT=3000
# HUNT_DOMAIN=hunt.example.com
# APP_ORIGIN=https://hunt.example.com
# MEDIA_DIRECTORY=/absolute/persistent/media/path

# Single-service cloud containers: npm run start:cloud
# APP_ORIGIN must use HTTPS. Filesystem media needs a persistent volume.
# PORT=3000
# Free cloud hosting uses a private Supabase Storage bucket instead of a disk.
# MEDIA_STORAGE=supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
# SUPABASE_STORAGE_BUCKET=treasure-hunt-v2-media
# Vercel also uses a separate private bucket for direct, unvalidated uploads.
# SUPABASE_UPLOAD_BUCKET=treasure-hunt-v2-incoming
# DATABASE_CA_CERT=<Supabase root CA PEM, stored as a server environment secret>
# CRON_SECRET=<random secret of at least 32 characters>

# Optional map provider configuration (default is OpenStreetMap/Leaflet):
# NEXT_PUBLIC_MAP_PROVIDER=google
# Public browser API key for Google Maps JavaScript API (MUST be restricted by HTTP referrer in Google Cloud Console):
# NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# Optional, ONLY for legacy V1 development:
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

